DATABASE_URL="file:./dev.db"
SESSION_SECRET="replace-with-a-long-random-secret"
# Session cookies are always Secure; this obsolete option is not read by the app.
ADMIN_EMAIL="admin@csir.res.in"
ADMIN_PASSWORD="replace-with-a-unique-strong-password"
UPLOAD_ROOT=""
FICCI_ROOT=""

# Exact allowed browser origins. Configure your actual HTTPS host before deployment.
APP_ORIGINS="http://localhost:3000"
# Only enable behind a trusted proxy that strips client-supplied forwarding headers.
TRUST_PROXY="0"

# Optional server-side AI enrichment. Local deterministic analysis works without it.
OPENAI_API_KEY=""
OPENAI_ANALYSIS_MODEL="gpt-5-mini"
