# Copy outside the source repository. Populate using your approved secret store.
NODE_ENV=production
HOSTNAME=127.0.0.1
PORT=3000
CSIR_REQUIRE_LOOPBACK_BIND=1
SESSION_SECRET=REPLACE_WITH_A_UNIQUE_RANDOM_SECRET_OF_AT_LEAST_48_BYTES
APP_ORIGINS=https://bdg.csir.res.in
TRUST_PROXY=1
# Keep sqlite for the existing installation; only switch after MySQL UAT/import.
DB_PROVIDER=sqlite
DATABASE_URL=file:/var/lib/csir-bdg/data/production.sqlite
# DB_PROVIDER=mysql
# MYSQL_DATABASE_URL=mysql://restricted_app_user:ENCODED_PASSWORD@127.0.0.1:3306/csir_bdg
UPLOAD_ROOT=/var/lib/csir-bdg/storage
FICCI_ROOT=/var/lib/csir-bdg/ficci
CLAMD_HOST=127.0.0.1
CLAMD_PORT=3310
MALWARE_SCAN_MODE=required
CSIR_TESTING_MODE=0
DOCUMENT_PARSER_MODE=container
DOCUMENT_PARSER_IMAGE=csir-document-parser:review
# Optional: enable only after building/testing Dockerfile.legacy on this host.
# LEGACY_PARSER_IMAGE=csir-legacy-parser:review
