DB_PROVIDER="mysql"
CSIR_LOCAL_MYSQL="0"
MYSQL_DATABASE_URL="mysql://APP_USER:URL_ENCODED_PASSWORD@127.0.0.1:3306/DATABASE_NAME"
DATABASE_URL="file:./dev.db"
SESSION_SECRET="replace-with-a-unique-random-secret-at-least-32-characters"
APP_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"
TRUST_PROXY="0"
UPLOAD_ROOT="REPLACE_WITH_EXISTING_UPLOAD_FOLDER"
FICCI_ROOT="REPLACE_WITH_EXISTING_FICCI_FOLDER"
# Windows: defender. Linux: required, with the approved ClamAV service configured.
MALWARE_SCAN_MODE="defender"
# Optional AI service. Keep empty unless configured through your secret manager.
OPENAI_API_KEY=""
